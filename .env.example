# Studio Planner - Environment Configuration Example
APP_NAME="Daftar"
APP_ENV=development
APP_PORT=8080
PMA_PORT=8081

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=studio_planner
DB_USER=studio_user
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# JWT / Session Secret Key
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional comma-separated allowlist. Leave empty for same-origin deployments.
ALLOWED_ORIGINS=
